{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env PORT=5173 max dev",
    "build": "max setup && tsc -b && max build",
    "lint": "node scripts/lint.mjs",
    "preview": "max preview",
    "lint:raw": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "max setup && tsc -b",
    "check": "npm run lint && npm run test && npm run typecheck",
    "test:e2e": "playwright test",
    "setup": "max setup",
    "postinstall": "max setup"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@codemirror/lang-json": "^6.0.2",
    "@uiw/react-codemirror": "^4.25.9",
    "@uiw/react-md-editor": "^4.1.1",
    "antd": "^5.29.3",
    "axios": "^1.7.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^14.6.0",
    "react": "^19.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^19.3.1",
    "rehype-sanitize": "^6.0.0",
    "@ant-design/pro-components": "^2.8.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "@umijs/max": "4.7.37",
    "cross-env": "^10.1.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "@umijs/max": {
      "antd": "$antd"
    },
    "@umijs/plugins": {
      "antd": "$antd",
      "@ant-design/pro-components": "$@ant-design/pro-components",
      "axios": "$axios"
    },
    "dva-immer": {
      "immer": "^9.0.21"
    },
    "decode-uri-component": "^0.5.1",
    "path-to-regexp@>=0.2.0 <1.9.0": "^1.9.0",
    "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
    "@umijs/bundler-vite": {
      "vite": "^7.3.8"
    }
  }
}
